# Modelo de configuracao do GoodWe HEMS-EV.
# Copie para .env (nao versionado) e ajuste: cp .env.example .env
# Os hosts abaixo (mysql, redis, backend, engine) sao os nomes dos servicos no Docker Compose.
# Para rodar fora do Docker, troque por localhost.
# Os nomes das variaveis sao proposta; mantenha este arquivo atualizado quando o codigo passar a usar uma nova.

# --- Backend (Node.js/TypeScript) ---
NODE_ENV=development
BACKEND_PORT=3000

# --- MySQL (historico de leituras e livro-razao do marketplace) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=hems
MYSQL_USER=hems
MYSQL_PASSWORD=troque_esta_senha
MYSQL_ROOT_PASSWORD=troque_esta_senha_root

# --- Redis (estado atual de cada casa) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Motor de decisao (Python), chamado pelo backend a cada passo ---
ENGINE_URL=http://engine:8000
# Usadas por `python -m engine.service` fora do Docker (o compose ja fixa 0.0.0.0:8000 no container)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=8000
# neutral devolve comandos zerados; http chama POST /decide no ENGINE_URL.
ENGINE_MODE=neutral
ENGINE_TIMEOUT_MS=5000
COMPARISON_FILE=dados/processados/comparison.json

# --- Adaptador GoodWe (README, secao 7.3) ---
# simulado | goodwe-local (nesta entrega apenas "simulado" e implementado)
ADAPTER_MODE=simulado
# So para o modo goodwe-local, com inversor real (UDP 8899 ou Modbus/TCP 502):
# GOODWE_INVERTER_IP=

# --- Simulador (Python) ---
# Atencao: o simulador ainda nao le este arquivo; recebe esses valores por argumentos (veja
# `python scripts/rodar_simulacao.py --help`). Das variaveis abaixo, so SIM_OPTIMIZATION e lida (pelo backend,
# que a repassa ao motor).
BACKEND_URL=http://backend:3000
# batch = sem espera entre passos; accelerated = SIM_SECONDS_PER_STEP segundos reais por passo (README, secao 3.5)
SIM_MODE=accelerated
SIM_SECONDS_PER_STEP=1
SIM_STEP_MINUTES=15
# Casas simuladas: 3 na demonstracao inicial, ate 10 (README, secao 4.3)
SIM_HOUSES=3
# Mesma semente nos cenarios sem e com otimizacao, para o comparativo ser reproduzivel
SIM_SEED=42
# Dias simulados e data de inicio (formato AAAA-MM-DD)
SIM_DAYS=7
SIM_START_DATE=2026-01-05
# false = cenario sem otimizacao; true = com otimizacao (README, secao 5.4)
SIM_OPTIMIZATION=true

# --- Marketplace ---
# financial_only: a energia negociada passa pela rede e so o dinheiro muda (README, secao 6)
MARKET_MODEL=financial_only
# Valor pago ao vendedor pela energia exportada (piso), em R$/kWh. Em aberto (CONTEXT, ponto 17):
# Obrigatorio em ENGINE_MODE=http; no modo neutro, custo liquido fica null se vazio.
EXPORT_VALUE_PER_KWH=

# --- Tarifas e emissoes ---
# Tarifa branca da Enel SP (gerada por scripts/extrair_tarifa_enel_sp.py)
TARIFF_FILE=dados/processados/tarifa_enel_sp_branca.csv
# Fator de emissao medio da rede (SIN), em kg CO2 por kWh, do SIRENE (MCTI). Em aberto (CONTEXT, ponto 4):
# Nao usar valor sem fonte oficial; a API retorna emissoes null se estiver vazio.
GRID_EMISSION_FACTOR_KG_PER_KWH=

# --- Perfis de geracao e consumo (gerados por scripts/) ---
SOLAR_PROFILE_FILE=dados/processados/perfil_solar_sp.csv
SOLAR_DAYS_FILE=dados/processados/dias_sp_classificados.csv

# --- Dashboard ---
DASHBOARD_PORT=8080

# --- ARIA (assistente virtual). Integracao em aberto (CONTEXT, pontos 8 e 21) ---
# ARIA_URL=
# Chave de API de modelo de linguagem, se a ARIA depender de uma. Nunca commitar o valor real.
# ARIA_API_KEY=
